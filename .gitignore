# Root .gitignore for AI Resume Tailor

# -----------------------------------------------------------------------------
# Environment & Secrets (Never commit real credentials or private keys)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
!**/.env.example
!**/*.env.example

# Security Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# -----------------------------------------------------------------------------
# Python / Backend
# -----------------------------------------------------------------------------
**/.venv/
**/venv/
**/env/
**/ENV/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Packaging & Distribution
build/
dist/
*.egg-info/
*.egg

# -----------------------------------------------------------------------------
# Node.js / Frontend
# -----------------------------------------------------------------------------
**/node_modules/
**/.next/
**/.turbo/
out/
.pnp
.pnp.*

# TypeScript Build Info
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel Deployment Output
.vercel/

# -----------------------------------------------------------------------------
# IDE & Editor Configuration
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# Operating System Artifacts
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
