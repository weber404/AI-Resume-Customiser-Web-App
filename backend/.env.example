# Backend Server Configuration
ENVIRONMENT=development # Set to "production" in production environments
DEBUG=true              # Set to false in production to disable verbose traces
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB upload ceiling
MIN_EXTRACTED_TEXT_CHARS=50   # Threshold to reject scanned/empty documents

# AI Provider Configuration (Required for resume tailoring)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_SECONDS=120.0

# Rate Limiting & Abuse Throttling
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TAILOR_REQUESTS_PER_MINUTE=10

